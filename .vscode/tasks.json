{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AuraGen: frontend",
      "type": "shell",
      "command": "npm run dev:web",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "AuraGen: backend",
      "type": "shell",
      "command": "npm run dev:api",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "AuraGen: develop",
      "dependsOn": [
        "AuraGen: frontend",
        "AuraGen: backend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "AuraGen: typecheck",
      "type": "shell",
      "command": "npm run typecheck",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "AuraGen: test",
      "type": "shell",
      "command": "npm test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "AuraGen: build",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
